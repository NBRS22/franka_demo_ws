<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fp3_moveit_server</name>
  <version>0.0.1</version>
  <description>Sole owner of the FP3 move_group bringup; exposes simple motion and (later) MTC pick/place primitives through a single command router</description>
  <maintainer email="n.elbachari@gmail.com">ngr</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>franka_demo_interfaces</depend>
  <depend>moveit_task_constructor_core</depend>
  <depend>moveit_task_constructor_msgs</depend>
  <depend>franka_msgs</depend>

  <!-- bringup.launch.py assembles move_group itself (adapted copy of
       franka_fp3_moveit_config/launch/moveit.launch.py, needed to inject
       the MTC capabilities parameter that launch file has no hook for) so
       these are exec-time, not build-time, dependencies. -->
  <exec_depend>franka_fp3_moveit_config</exec_depend>
  <exec_depend>franka_bringup</exec_depend>
  <exec_depend>franka_description</exec_depend>
  <exec_depend>franka_gripper</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- runtime-loaded move_group capability plugin (pluginlib), not linked
       against directly -->
  <exec_depend>moveit_task_constructor_capabilities</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
