<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>calib_rigidity_test</name>
  <version>0.1.0</version>
  <description>
    Diagnostic: verifies the calibration tag/cube is rigidly fixed to fp3_hand
    across a large orientation swing, without depending on the hand-eye
    calibration being diagnosed. Compares the tag's camera-frame drift
    against fp3_hand's own FK drift after a joint-space return to the exact
    starting configuration.
  </description>
  <maintainer email="n.elbachari@gmail.com">nour el bachari</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>apriltag_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>fp3_moveit_server</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
