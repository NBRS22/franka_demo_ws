<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>calib_click_test</name>
  <version>0.1.0</version>
  <description>
    Interactive calibration check: click any point in RViz's point cloud
    (Publish Point tool -&gt; /clicked_point) and fp3_hand_tcp moves there
    (position only, no gripper action). Self-contained launcher -- real arm,
    camera with pointcloud.enable:=true, and handeye_tf_publisher (the
    calibration under test).
  </description>
  <maintainer email="n.elbachari@gmail.com">nour el bachari</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <exec_depend>fp3_moveit_server</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>handeye_tf_publisher</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
